<section class="hero">
  <img class="hero__img" src="/images/home-hero.webp" alt="Guest holding a redfish caught near New Smyrna Beach" width="1286" height="757" fetchpriority="high">
  <div class="hero__in">
    <a class="hero__rating" href="{{ site.googleReviews }}" target="_blank" rel="noopener" aria-label="Rated {{ reviews.rating }} out of 5 from {{ reviews.count }} Google reviews"><svg class="hero__g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg><strong>{{ reviews.rating }}</strong><span class="hero__stars" aria-hidden="true">★★★★★</span><span class="hero__count">{{ reviews.count }} Google reviews</span></a>
    <h1>New Smyrna Beach Fishing Charters &amp; Dolphin Tours</h1>
    <p class="hero__lede">Private fishing charters and dolphin tours with Capt. Chad Knight, a USCG licensed captain.</p>
    <div class="btns">
      <a class="btn btn--red" href="/charters">See Charters</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Welcome to Reel Deal Fishin' Charters</p>
      <h2>One of Florida's Best Kept Secrets</h2>
      <p>Some mornings start on the Ponce Inlet rocks, with slot <a href="/redfish">redfish</a> feeding on the incoming tide. Other days it's <a href="/shark-fishing">blacktips just off the beach</a>, <a href="/inshore#snook">snook around the bridges</a> or <a href="/dolphin">dolphins in the lagoon</a>.</p>
      <p>Every trip is private: your group, <a href="/about">Capt. Chad Knight</a> and his 22' Sundance skiff, up to 6 guests. He plans each trip around the tide and the bite, from calm <a href="/inshore">inshore trips</a> in the lagoon to <a href="/nearshore">nearshore fishing</a> up to 6 miles off the beach. Staying up the road? We run <a href="/daytona-beach">Daytona Beach fishing charters</a> too.</p>
      <p><strong>Chad fishes where the bite is, not where the brochure says to go.</strong></p>
      <a class="btn btn--navy" href="/charters">See All Charters</a>
    </div>
    <div class="split__media"><img src="/images/home-a.webp" alt="Family with a catch of sheepshead on the Reel Deal boat" width="800" height="680" loading="lazy"></div>
  </div>
</section>

<section class="sec sec--sand">
  <div class="wrap">
    <div class="sec__head sec__head--center">
      <p class="eyebrow">Charter trips &amp; tours</p>
      <h2>Pick Your Trip</h2>
      <p>Every trip is private, up to 6 guests, and leaves from New Smyrna Beach. <a href="/charters#prices">See all prices</a>, or get answers to <a href="/faqs">common questions</a> before you book.</p>
    </div>
    <div class="cards">
      {%- for t in trips %}
      <article class="card">
        <div class="card__img"><a href="{{ t.url }}" tabindex="-1" aria-hidden="true"><img src="/images/{{ t.img }}.webp" alt="{{ t.alt }}" loading="lazy" width="800" height="600"></a><span class="card__tag{% if t.signature %} card__tag--red{% endif %}">{{ t.tag }}</span></div>
        <div class="card__body">
          <h3><a href="{{ t.url }}">{{ t.name }}</a></h3>
          {% if t.price %}<p class="card__meta">{{ t.price }} · {{ t.len }}</p>{% endif %}<p>{{ t.hook }}</p>
          <div class="card__links"><a class="btn btn--outline" href="{{ t.url }}">Learn More<span class="sr-only"> about {{ t.name }}</span></a><a class="btn btn--red" href="{{ t.book }}" target="_blank" rel="noopener">{{ t.bookLabel or "Book Now" }}</a></div>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="sec sec--reviews">
  <div class="wrap">
    <div class="sec__head sec__head--center">
      <p class="eyebrow">Happy customers say it best</p>
      <h2>What Our Guests Say</h2>
    </div>
    {%- set rvItems = reviews.quotes | reviewsByIds(reviews.featured) %}{% include "reviews-block.njk" %}
    <p style="text-align:center;margin-top:26px"><a href="/reviews"><strong>Read more guest reviews</strong></a></p>
  </div>
</section>

<section class="sec sec--navy">
  <div class="wrap">
    <div class="sec__head">
      <p class="eyebrow">Fishing New Smyrna Beach &amp; Daytona</p>
      <h2>Where We Fish</h2>
      <p>We fish the Indian River Lagoon, Mosquito Lagoon, the Halifax River and Ponce Inlet, and run up to 6 miles off the beach when the ocean lays down. Where we start depends on the tide and the bite.</p>
    </div>
    <div class="places">
      {%- for pl in places %}
      <div class="place">
        <img src="/images/{{ pl.img }}.webp" alt="{{ pl.alt }}" width="800" height="600" loading="lazy">
        <div class="place__body">
          <h3>{% if pl.url %}<a href="{{ pl.url }}">{{ pl.name }}</a>{% else %}{{ pl.name }}{% endif %}</h3>
          <p>{{ pl.text }}</p>
        </div>
      </div>
      {%- endfor %}
    </div>
    <p style="margin-top:30px"><strong>Common targets:</strong> redfish, trout, snook and flounder &middot; tarpon, kingfish, cobia and sharks &middot; sheepshead, black drum, mullet and blue crabs.</p>
    <p class="place__credits">Photos: {% for pl in places %}{{ pl.name }} by <a href="{{ pl.creditUrl }}" target="_blank" rel="nofollow noopener">{{ pl.credit }}</a>{% if pl.license %} (<a href="{{ pl.licenseUrl }}" target="_blank" rel="nofollow noopener">{{ pl.license }}</a>, cropped){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
  </div>
</section>

<section class="sec">
  <div class="wrap captain">
    <img src="/images/home-d.webp" alt="Capt. Chad Knight with a catch of sheepshead" width="466" height="678" loading="lazy">
    <div>
      <p class="eyebrow">Your captains</p>
      <h2>Meet the Captains</h2>
      <h3>Capt. Chad Knight</h3>
      <p>Capt. Chad Knight owns Reel Deal Fishin' Charters. He grew up loving the outdoors and moved to Florida from Tennessee when he was 11. Since then, the water's been his home.</p>
      <p>He built the business around three things that mean the most to him: God, family and fishing. He's great with kids, and guests regularly mention how patient he is with first timers.</p>
      <p><span class="badge">USCG 50 Ton Master License</span><span class="badge">Towing endorsement</span></p>
      <h3>Capt. Falon</h3>
      <p>Capt. Falon grew up around the water and especially loves chasing snook, redfish, trout, flounder and tarpon. A guest put it simply: <em>"captain falon was very friendly and knowledgeable kept us on fish the whole time."</em></p>
      <a class="btn btn--navy" href="/about">Meet the Captains</a>
    </div>
  </div>
</section>

<section class="sec sec--navy">
  <div class="wrap split">
    <div>
      <p class="eyebrow">In the news</p>
      <h2>As Seen on FOX 35 Orlando</h2>
      <p>When the fall mullet run had fish leaping into boats at Ponce Inlet, FOX 35 Orlando came out to the Indian River Lagoon and talked with Capt. Chad about it.</p>
      <p>His take on the run: it <strong>"makes fishing phenomenal right now."</strong></p>
      <div class="btns"><a class="btn btn--red" href="/post/annual-mullet-migration-fuels-fishing-frenzy-along-central-florida-coast">Read the Story</a></div>
    </div>
    <div class="split__media split__media--video">
      <a class="vthumb" href="/post/annual-mullet-migration-fuels-fishing-frenzy-along-central-florida-coast" aria-label="Read the FOX 35 Orlando mullet run story and watch the video">
        <img src="/images/fox35-mullet-cover.webp" alt="FOX 35 Orlando Mullet Mayhem story, showing mullet in Capt. Chad Knight's boat (video source: Chad Knight)" width="1526" height="866" loading="lazy">
        <span class="vthumb__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="vthumb__label">As seen on FOX 35 Orlando</span>
      </a>
      <p class="vthumb__credit">Image: FOX 35 Orlando</p>
    </div>
  </div>
</section>

<section class="sec sec--sand">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Our boat</p>
      <h2>22' Sundance Skiff</h2>
      <p>We run a 22' Sundance skiff with quiet power, LED light rigs for night trips and a layout designed for fishing comfort and wildlife viewing. Shallow enough for the backwaters. Solid enough for nearshore hunts.</p>
      <h3>Every trip includes</h3>
      <ul class="ticks">
        <li>U.S. Coast Guard licensed captain</li>
        <li>All rods, reels, bait and tackle</li>
        <li>Your Florida fishing license</li>
        <li>Fish cleaning for in season species</li>
      </ul>
      <p>Bring your own snacks and drinks (no glass), sunscreen and polarized sunglasses. Trips depart from New Smyrna Beach, FL.</p>
    </div>
    <div class="split__media"><img src="/images/boat.webp" alt="The Reel Deal 22 foot Sundance skiff on calm, clear water" width="958" height="960" loading="lazy"></div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec__head"><p class="eyebrow">Real trips, real fish</p><h2>Latest Fishing Reports</h2><p>What our crews have been catching around New Smyrna Beach and Daytona, written up once a month.</p></div>
    <div class="reports">
      {%- for r in collections.reports | head(3) %}
      <a class="report-card" href="{{ r.url | cleanUrl }}">
        <img src="/images/{{ r.data.hero }}.webp" alt="{{ r.data.heroAlt }}" loading="lazy" width="800" height="600">
        <div><time datetime="{{ r.date | dateIso }}">{{ r.date | dateDisplay }}</time><h3>{{ r.data.h1 }}</h3></div>
      </a>
      {%- endfor %}
    </div>
    <div class="btns"><a class="btn btn--outline" href="/fishing-reports">All Fishing Reports</a></div>
    <div class="gstrip">
      {%- for g in ["r-jul-5", "r-mar-4", "r-may-8", "day-e"] %}
      <a href="/gallery"><img src="/images/{{ g }}.webp" alt="Reel Deal Fishin' Charters trip photo" width="400" height="400" loading="lazy"></a>
      {%- endfor %}
    </div>
    <div class="btns"><a class="btn btn--outline" href="/gallery">See the Photo Gallery</a></div>
  </div>
</section>

<section class="sec sec--sand">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Something different</p>
      <h2>Private Boat Training</h2>
      <p>Just bought your first boat? Chad offers one on one training for new and inexperienced boat owners, using your own boat and trailer.</p>
      <p>Learn launching, loading, trailer backing and ramp etiquette at your own pace.</p>
      <a class="btn btn--navy" href="/charters#boat-training">Learn More<span class="sr-only"> about boat training</span></a>
    </div>
    <div class="split__media"><img src="/images/day-b.webp" alt="Guest holding a snook on the Reel Deal skiff near a bridge" width="800" height="680" loading="lazy"></div>
  </div>
</section>
