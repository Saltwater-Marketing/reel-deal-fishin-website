---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex and p.url and (p.url.endsWith(".html") or p.url == "/") %}
  <url><loc>{{ site.url }}{{ p.url | cleanUrl }}</loc><lastmod>{{ p.date | dateIso }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
