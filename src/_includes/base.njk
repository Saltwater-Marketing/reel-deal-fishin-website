{%- set canonical = site.url + (page.url | cleanUrl) -%}
{%- set shareBase = build.previewOrigin or site.url -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex or not build.indexable %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ shareBase + (page.url | cleanUrl) }}">
<meta property="og:image" content="{{ shareBase }}/images/{{ hero or 'home-hero' }}.webp">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/images/logo.webp" type="image/webp">
<link rel="preload" href="/assets/fonts/barlow-condensed-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
<style>{% for k, v in focal %}{% if k != "_note" %}img[src="/images/{{ k }}.webp"]{object-position:{{ v }}}{% endif %}{% endfor %}</style>
{%- if hero %}<link rel="preload" as="image" href="/images/{{ hero }}.webp" fetchpriority="high">{% endif %}
<!-- Google Tag Manager (loads GA4 G-8JG9Z386NG and Google Ads AW-16937881099) -->
<script>
/* Tracking (GTM: GA4 + Google Ads) and the chat widget load on the first scroll, tap, key or mouse move,
   or 6 seconds after the page loads, so they don't slow the first paint. */
window.dataLayer=window.dataLayer||[];
(function(){var done=false;function go(){if(done)return;done=true;
 window.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});
 var g=document.createElement('script');g.async=true;g.src='https://www.googletagmanager.com/gtm.js?id={{ site.gtm }}';document.head.appendChild(g);
 var c=document.createElement('script');c.src='https://widgets.leadconnectorhq.com/loader.js';c.setAttribute('data-resources-url','https://widgets.leadconnectorhq.com/chat-widget/loader.js');c.setAttribute('data-widget-id','{{ site.chatWidgetId }}');document.body.appendChild(c);}
 ['scroll','pointerdown','keydown','touchstart','mousemove'].forEach(function(e){window.addEventListener(e,go,{once:true,passive:true});});
 window.addEventListener('load',function(){setTimeout(go,6000);});})();
</script>
{%- if schema %}
<script type="application/ld+json">{{ schema | json | safe }}</script>
{%- endif %}
{%- if faqSchema and faq %}
<script type="application/ld+json">{
  "@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- for q in faq %}{"@type":"Question","name":{{ q.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ q.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
{%- endif %}
{%- block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<a class="skip" href="#main">Skip to content</a>

<div class="topbar">
  <div class="wrap topbar__in">
    <span>Private charters &amp; eco tours &middot; New Smyrna Beach &amp; Daytona</span>
    <a href="{{ site.phoneHref }}">Call or text {{ site.phone }}</a>
  </div>
</div>

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__logo" href="/" aria-label="Reel Deal Fishin' Charters home">
      <img src="/images/logo-300.webp" srcset="/images/logo-300.webp 300w, /images/logo.webp 544w" sizes="150px" alt="Reel Deal Fishin' Charters logo" width="544" height="312">
    </a>
    <input type="checkbox" id="navtoggle" class="nav__toggle" aria-label="Open menu">
    <label for="navtoggle" class="nav__burger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li class="{% if item.children %}has-sub{% endif %}">
          <a href="{{ item.url }}"{% if (page.url | cleanUrl) == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- if item.children %}
          <ul class="sub">
            {%- for c in item.children %}<li><a href="{{ c.url }}">{{ c.label }}</a></li>{% endfor %}
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
      <a class="btn btn--red nav__book" href="{{ site.booking }}" target="_blank" rel="noopener">Book Now</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<section class="cta-band">
  <div class="wrap cta-band__in">
    <div>
      <p class="eyebrow eyebrow--light">Private trips &middot; Your group only</p>
      <h2>Ready to get on the water?</h2>
      <p>Book online or call Capt. Chad. We'll match the trip to the season, the tide and your crew.</p>
    </div>
    <div class="cta-band__btns">
      <a class="btn btn--red" href="{{ site.booking }}" target="_blank" rel="noopener">Book Now</a>
      <a class="btn btn--ghost" href="{{ site.phoneHref }}">Call {{ site.phone }}</a>
    </div>
  </div>
</section>

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <img src="/images/logo-footer.webp" alt="Reel Deal Fishin' Charters" width="677" height="379" loading="lazy">
      <p>Private fishing charters and eco tours in New Smyrna Beach and Daytona Beach with Capt. Chad Knight.</p>
      <p class="ftr__social">
        <a href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Reel Deal Fishin' Charters on Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></a>
        <a href="{{ site.youtube }}" target="_blank" rel="noopener" aria-label="Capt. Chad on YouTube" title="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
        <a href="{{ site.googleReviews }}" target="_blank" rel="noopener" aria-label="Google reviews" title="Google reviews"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/></svg></a>
      </p>
    </div>
    <div>
      <h3>Charters</h3>
      <ul>
        {%- for t in trips %}<li><a href="{{ t.url }}">{{ t.name }}</a></li>{% endfor %}
        <li><a href="/daytona-beach">Daytona Beach Charters</a></li>
      </ul>
    </div>
    <div>
      <h3>Fishing Info</h3>
      <ul>
        <li><a href="/fishing-reports">Fishing Reports</a></li>
        <li><a href="/faqs">FAQ</a></li>
        <li><a href="/about">Capt. Chad Knight</a></li>
        <li><a href="/gallery">Gallery</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul>
        <li>{{ site.city }}</li>
        <li><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="/contact">Send a message</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__base">
    <p>&copy; {{ build.year }} Reel Deal Fishin' Charters &middot; <a href="/privacy-policy">Privacy Policy</a> &middot; <a href="/terms-conditions">Terms &amp; Conditions</a></p>
    <p><a href="https://www.saltwatermarketing.net/" target="_blank" rel="noopener">Charter fishing marketing by Saltwater Marketing</a></p>
  </div>
</footer>



</body>
</html>
